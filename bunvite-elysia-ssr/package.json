{
  "name": "bunvite-elysia-ssr",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev:vite": "bunx --bun vite",
    "dev:server": "NODE_ENV=development bun --hot server.js",
    "dev": "bun run dev:server",
    "build:client": "vite build --ssrManifest --outDir dist/client",
    "build:server": "vite build --ssr --outDir dist/server",
    "build": "bun run build:client && bun run build:server",
    "start": "NODE_ENV=production bun server.js"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "vite": "^7.0.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/html": "^1.3.0",
    "@elysiajs/node": "^1.3.0",
    "@elysiajs/static": "^1.3.0",
    "elysia": "^1.3.5",
    "mime-types": "^3.0.1"
  }
}
